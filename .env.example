FOUNDRY_ENDPOINT=https://<your-project-endpoint>.services.ai.azure.com/
# Optional: omit FOUNDRY_API_KEY to authenticate via Azure CLI (`az login`)
FOUNDRY_API_KEY=<your-project-api-key>
FOUNDRY_API_VERSION=2025-04-01-preview
FLUX_DEPLOYMENT_NAME=FLUX.2-pro
GPT_DEPLOYMENT_NAME=gpt-image-2
INPUT_IMAGE=<path to your image with file ending>
INPUT_IMAGE_2=<optional: path to second image for Flux-2>
PROMPT=<Your edit prompt>

# Image processing settings (optional)
MAX_IMAGE_MP=4.0
MAX_IMAGE_DIMENSION=2048

# GPT image edit options (all optional)
# Output file format: png (default), jpeg, or webp
#GPT_OUTPUT_FORMAT=png
# Compression level 0-100, only applied for jpeg/webp
#GPT_OUTPUT_COMPRESSION=85
# Content moderation strictness: auto (default) or low
#GPT_MODERATION=auto
# Number of image variants to generate per request (default 1)
#GPT_N=1